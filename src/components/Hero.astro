---
import { stats as siteStats } from '../data/site';
import { Award, Factory, Globe2, Cog, Clock } from 'lucide-astro';

type HeroAction = {
  label: string;
  href: string;
};

type HeroStat = {
  value: string;
  label: string;
  icon: any;
};

type HeroProps = {
  imageSrc?: string;
  mobileImageSrc?: string;
  imageAlt?: string;
  title?: string;
  description?: string;
  primaryAction?: HeroAction;
  secondaryAction?: HeroAction;
};

const {
  imageSrc = "https://img.tyuanwaterproof.com/banner.webp",
  mobileImageSrc = "https://img.tyuanwaterproof.com/banner-mobile.webp",
  imageAlt = "Professional waterproofing membrane installation on a modern roof",
  title = "Waterproofing Materials Supplier from China",
  description = "Factory supply of waterproofing membranes, tapes and coatings with OEM packaging, technical data support and fast quotation service.",
  primaryAction = {
    label: "Request a Quote →",
    href: "/contact/",
  },
  secondaryAction = {
    label: "View Products",
    href: "/products/",
  },
} = Astro.props as HeroProps;

const stats: HeroStat[] = [
  { value: "30+", label: "Years Experience", icon: Award },
  { value: "5", label: "Production Lines", icon: Factory },
  { value: "50+", label: "Export Countries", icon: Globe2 },
  { value: "OEM/ODM", label: "Custom Service", icon: Cog },
  { value: "24/7", label: "Quick Response", icon: Clock },
];
---

<section class="relative w-full overflow-hidden bg-[#0E2A47] text-white">
  <!-- Hero Main Area -->
  <div class="relative min-h-[540px] md:min-h-[720px] flex items-center">
    <!-- Background Image - Focused on top/center to show product -->
    <div class="absolute inset-0 z-0">
      <picture>
        <source srcset={mobileImageSrc} media="(max-width: 768px)" width="768" height="1024" />
        <img
          src={imageSrc}
          alt={imageAlt}
          class="absolute inset-0 h-full w-full object-cover object-top md:object-center lg:object-[center_right]"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <!-- Gradient Overlay -->
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(14,42,71,0.4)_0%,rgba(14,42,71,0.85)_80%,#0E2A47_100%)] md:bg-[linear-gradient(90deg,rgba(8,24,49,0.95)_0%,rgba(14,42,71,0.85)_40%,rgba(14,42,71,0.3)_100%)] z-10"></div>
    </div>

    <!-- Content -->
    <div class="relative mx-auto w-full max-w-[1680px] px-6 lg:px-16 z-20 pt-12 pb-8 md:py-0">
      <div class="max-w-[720px] text-left">
        <div class="inline-flex items-center gap-2 bg-blue-600/20 border border-blue-400/30 px-3 py-1 rounded-full mb-6 md:mb-8 backdrop-blur-md">
          <span class="w-2 h-2 bg-blue-400 rounded-full animate-pulse"></span>
          <span class="text-[10px] md:text-xs font-black uppercase tracking-widest text-blue-200">Factory Direct Sourcing</span>
        </div>
        
        <h1 style="line-height: 1.2;" class="text-4xl md:text-7xl font-black tracking-tight text-white mb-6 md:mb-8">
          {title}
        </h1>

        <p class="text-base md:text-xl leading-relaxed text-white/90 max-w-[620px] mb-8 md:mb-12 font-medium">
          {description}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 md:gap-6">
          <a
            href={primaryAction.href}
            class="inline-flex items-center justify-center rounded-xl md:rounded-2xl bg-[#C05800] px-8 md:px-12 py-4 md:py-5 text-base font-black text-white shadow-xl shadow-[#C05800]/40 transition-all hover:bg-[#D96A0A] active:scale-95"
          >
            {primaryAction.label}
          </a>

          <a
            href={secondaryAction.href}
            class="inline-flex items-center justify-center rounded-xl md:rounded-2xl border-2 border-white/20 px-8 md:px-12 py-4 md:py-5 text-base font-bold text-white transition-all hover:bg-white hover:text-[#0E2A47] backdrop-blur-sm active:scale-95"
          >
            {secondaryAction.label}
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Redesigned Stats Bar - Compact Version -->
  <div class="relative z-30 bg-[#0E2A47] border-t border-white/10">
    <div class="absolute inset-0 bg-gradient-to-r from-blue-900/20 via-transparent to-blue-900/20 opacity-30"></div>
    <dl class="relative mx-auto grid w-full max-w-[1680px] grid-cols-2 md:grid-cols-5 divide-x divide-white/5">
      {stats.map((item) => (
        <div class="group px-4 py-6 md:px-6 md:py-10 flex flex-col items-center justify-center text-center transition-all hover:bg-white/5">
          <div class="mb-2 md:mb-4 text-blue-400 group-hover:scale-110 transition-all duration-300" aria-hidden="true">
            <item.icon class="w-5 h-5 md:w-7 md:h-7" strokeWidth={2.5} />
          </div>
          <dd class="text-2xl md:text-[42px] font-black text-white leading-none mb-2 tracking-tighter">
            {item.value}
          </dd>
          <dt class="text-[9px] md:text-[11px] font-black uppercase tracking-[0.15em] text-blue-200/70 group-hover:text-white transition-colors">
            {item.label}
          </dt>
        </div>
      ))}
    </dl>
  </div>
</section>
