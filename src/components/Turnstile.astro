---
const sitekey = "0x4AAAAAAEFV-aa3nhpRSCsJ";
---

<!-- Load verification near a form or when that form is used, not on unrelated scrolling. -->
<div class="cf-turnstile min-h-[65px]" data-sitekey={sitekey}></div>
<script>
  (() => {
    let scheduled = false;
    let loaded = false;
    const widgets = document.querySelectorAll<HTMLElement>('.cf-turnstile');
    function loadTurnstile() {
      if (loaded) return;
      loaded = true;
      if (document.querySelector('script[src^="https://challenges.cloudflare.com/turnstile/v0/api.js"]')) return;
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
      script.async = true;
      document.head.appendChild(script);
    }
    function schedule() {
      if (scheduled) return;
      scheduled = true;
      if ('requestIdleCallback' in window) requestIdleCallback(loadTurnstile, { timeout: 1000 });
      else setTimeout(loadTurnstile, 0);
    }
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        if (entries.some(entry => entry.isIntersecting)) {
          observer.disconnect();
          schedule();
        }
      }, { rootMargin: '300px 0px' });
      widgets.forEach(widget => observer.observe(widget));
    } else schedule();
    widgets.forEach(widget => {
      const form = widget.closest('form');
      form?.addEventListener('focusin', schedule, { once: true });
      form?.addEventListener('pointerdown', schedule, { once: true, passive: true });
    });
  })();
</script>
