<!--
  FormAjax: turns any <form data-ajax> into an in-page AJAX submission.
  - Success: the form is replaced in place by a confirmation card (no redirect away from the site).
  - Server-side validation error: inline error message + Turnstile reset + retry stays enabled.
  - Network/CSP failure: falls back to the native POST so an inquiry is never lost.
  - Fires GA4 events (form_submit_success / form_submit_error) via window.__track when GA4 is configured.
  Used by: /contact/ full form and the site-wide CTA quick form.
-->
<script>
  (function () {
    const forms = document.querySelectorAll<HTMLFormElement>('form[data-ajax]');
    const trackingWindow = window as Window & {
      __track?: (name: string, params: Record<string, string>) => void;
      turnstile?: { reset: (widget?: HTMLElement) => void };
    };

    function clearMessages(form: HTMLFormElement) {
      form.querySelectorAll('.form-ajax-error').forEach(function (el) { el.remove(); });
    }

    function showError(form: HTMLFormElement, message: string) {
      clearMessages(form);
      var box = document.createElement('p');
      box.className = 'form-ajax-error mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700';
      box.setAttribute('role', 'alert');
      box.textContent = message;
      form.prepend(box);
      // Turnstile tokens expire (~5 min); force a fresh challenge after a server-side rejection.
      if (trackingWindow.turnstile) {
        const widget = form.querySelector<HTMLElement>('.cf-turnstile');
        if (widget) trackingWindow.turnstile.reset(widget);
      }
    }

    function showSuccess(form: HTMLFormElement) {
      var wrap = document.createElement('div');
      wrap.className = 'rounded-2xl border border-emerald-200 bg-emerald-50 p-8 text-center';
      wrap.setAttribute('role', 'status');
      var heading = document.createElement('p');
      heading.className = 'text-lg font-black text-emerald-800';
      heading.textContent = 'Inquiry received - thank you!';
      var note = document.createElement('p');
      note.className = 'mt-2 text-sm leading-6 text-emerald-700';
      note.textContent = 'Our sales team will reply within 1 business day. Adding your quantity, specification and destination port to your email thread helps us quote faster.';
      wrap.appendChild(heading);
      wrap.appendChild(note);
      if (form.parentNode) form.parentNode.insertBefore(wrap, form);
      form.style.display = 'none';
    }

    function fire(form: HTMLFormElement, name: string, extra: Record<string, string> = {}) {
      var fd = new FormData(form);
      const params: Record<string, string> = {
        category: String(fd.get('Product Interest') || fd.get('category') || ''),
        product: String(fd.get('Specific Product') || fd.get('Product') || ''),
        intent: String(fd.get('Inquiry Intent') || 'contact_form'),
        source: String(fd.get('Source Page') || window.location.pathname)
      };
      Object.assign(params, extra);
      trackingWindow.__track?.(name, params);
    }

    forms.forEach(function (form) {
      form.addEventListener('submit', function (e) {
        if (form.dataset.fallback) return; // native fallback path: allow default navigation
        if (e.defaultPrevented) return; // another handler (e.g. phone/country validation) already blocked the submit
        e.preventDefault();
        if (form.dataset.sending) return false;
        form.dataset.sending = '1';
        var btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (btn) btn.disabled = true;
        clearMessages(form);

        fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' }
        })
          .then(function (res) {
            if (res.ok) {
              fire(form, 'form_submit_success');
              showSuccess(form);
              return;
            }
            return res.json().catch(function () { return null; }).then(function (j) {
              var msg = 'Submission failed. Please try again.';
              if (j && j.errors && j.errors.length) {
                var joined = (j.errors as Array<{ message: string }>).map((x) => x.message).filter(Boolean).join('; ');
                if (joined) msg = joined;
              } else if (j && j.error) {
                msg = String(j.error);
              }
              fire(form, 'form_submit_error', { reason: 'server_' + res.status });
              showError(form, msg);
              form.dataset.sending = '';
              if (btn) btn.disabled = false;
            });
          })
          .catch(function () {
            // Network / CSP failure: degrade to the original native POST so the
            // inquiry still reaches Formspree (worst case = the old redirect UX).
            fire(form, 'form_submit_error', { reason: 'network_fallback' });
            form.dataset.sending = '';
            if (btn) btn.disabled = false;
            form.dataset.fallback = '1';
            form.submit();
          });
      });
    });
  })();
</script>
