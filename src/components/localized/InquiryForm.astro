---
import Turnstile from '../Turnstile.astro';
import FormAjax from '../FormAjax.astro';
import translations from '../../i18n/ui.json';
import productText from '../../i18n/products.json';
const { locale } = Astro.props as { locale: 'th' | 'vi' };
const ui = translations[locale];
---
<form id="inquiry-form" action="https://formspree.io/f/mzdqdpwd" method="POST" data-ajax data-success-title={ui.success} data-success-note={ui.successNote} data-error-message={ui.error} class="scroll-mt-28 space-y-5 rounded-3xl border border-slate-200 bg-white p-6 md:p-9">
  <h2 class="text-2xl font-bold">{ui.formTitle}</h2>
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  <input type="hidden" name="Language" value={locale} />
  <input type="hidden" name="Source Page" value={Astro.url.pathname} />
  <input type="hidden" name="Inquiry Intent" value="quote" />
  <div class="grid gap-5 sm:grid-cols-2">
    <label class="block text-sm font-bold">{ui.name}<input class="input mt-2 w-full" type="text" name="name" autocomplete="name" required maxlength="150" /></label>
    <label class="block text-sm font-bold">{ui.email}<input class="input mt-2 w-full" type="email" name="email" autocomplete="email" required maxlength="254" /></label>
    <label class="block text-sm font-bold">{ui.company}<input class="input mt-2 w-full" type="text" name="Company" autocomplete="organization" maxlength="200" /></label>
    <label class="block text-sm font-bold">{ui.country}<input class="input mt-2 w-full" type="text" name="Country" autocomplete="country-name" required value={locale === 'th' ? 'ประเทศไทย' : 'Việt Nam'} maxlength="100" /></label>
  </div>
  <label class="block text-sm font-bold">{ui.phone}<input class="input mt-2 w-full" type="tel" name="Phone" autocomplete="tel" maxlength="80" /></label>
  <label class="block text-sm font-bold">{ui.product}<select name="Specific Product" class="input mt-2 w-full"><option value="">{ui.choose}</option>{Object.entries(productText).map(([slug, data]) => <option value={slug}>{data[locale].title}</option>)}</select></label>
  <label class="block text-sm font-bold">{ui.message}<textarea class="input mt-2 w-full" name="message" rows="5" required maxlength="10000" placeholder={ui.placeholder}></textarea></label>
  <p class="text-sm leading-7 text-slate-600">{ui.consent} <a href="/privacy-policy/" lang="en" class="text-blue-700 underline">{ui.privacy}</a></p>
  <Turnstile />
  <button type="submit" class="w-full rounded-xl bg-[#C05800] px-6 py-4 font-bold text-white transition hover:bg-[#9E4700] disabled:opacity-50">{ui.send}</button>
</form>
<FormAjax />
<script>
  const form = document.querySelector<HTMLFormElement>('form[data-ajax]');
  if (form) {
    const params = new URLSearchParams(window.location.search);
    const product = params.get('product');
    const select = form.querySelector<HTMLSelectElement>('select[name="Specific Product"]');
    if (product && select && [...select.options].some(option => option.value === product)) select.value = product;
    const source = params.get('source');
    const sourceField = form.querySelector<HTMLInputElement>('input[name="Source Page"]');
    if (source && source.startsWith('/') && source.length < 500 && sourceField) sourceField.value = source;
  }
</script>
