---
import { languages, localeOf, basePath, localizedPaths, languagePath } from '../i18n/routes.mjs';
import { Globe, ChevronDown, Check } from 'lucide-astro';
const { inline = false } = Astro.props;
const path = Astro.url.pathname;
const locale = localeOf(path);
const base = basePath(path);
const hasEquivalent = localizedPaths.includes(base);
const label = locale === 'th' ? 'ภาษา' : locale === 'vi' ? 'Ngôn ngữ' : ['es','pt-br'].includes(locale) ? 'Idioma' : 'Language';
const homeLabel = locale === 'th' ? 'หน้าแรก' : locale === 'vi' ? 'Trang chủ' : locale === 'pt-br' ? 'Início' : locale === 'es' ? 'Inicio' : 'Home';
const flags = { en: 'gb', th: 'th', vi: 'vn', es: 'es', 'pt-br': 'br' };
const currentLanguage = languages.find(language => language.code === locale);
---
<details class="language-switcher relative text-sm">
  <summary class="flex min-h-11 cursor-pointer list-none items-center justify-center gap-2 rounded-xl border border-white/30 px-3 py-2 font-semibold text-white hover:border-white/50 hover:bg-white/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-400 [&::-webkit-details-marker]:hidden" aria-label={`${label}: ${currentLanguage?.label}`}>
    <Globe size={17} aria-hidden="true" />
    <img src={`/flags/${flags[locale]}.svg`} width="20" height="15" alt="" class="h-[15px] w-5 shrink-0 rounded-sm object-cover" />
    <span lang={locale}>{currentLanguage?.label}</span>
    <ChevronDown size={13} class="language-arrow shrink-0 transition-transform" aria-hidden="true" />
  </summary>
  <nav aria-label={label} class={`${inline ? 'relative w-full' : 'absolute right-0 w-[216px]'} z-[150] mt-3 rounded-xl border border-slate-200 bg-white p-2 text-slate-900 shadow-xl`}>
    {languages.map(language => <a href={languagePath(hasEquivalent || language.code === 'en' ? base : '/', language.code)} lang={language.code} aria-current={language.code === locale ? 'page' : undefined} class={`flex min-h-12 items-center gap-3 rounded-lg px-3 py-3 font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-orange-400 ${language.code === locale ? 'bg-[#edf4fb] text-[#174d7a]' : 'hover:bg-slate-100'}`}>
      <img src={`/flags/${flags[language.code as keyof typeof flags]}.svg`} width="20" height="15" alt="" class="h-[15px] w-5 shrink-0 rounded-sm object-cover" />
      <span>{language.label}{!hasEquivalent && language.code !== 'en' && <span class="ml-2 text-xs text-slate-500">({homeLabel})</span>}</span>
      {language.code === locale && <Check size={17} class="ml-auto shrink-0" aria-hidden="true" />}
    </a>)}
  </nav>
</details>
<style>
  .language-switcher[open] > summary .language-arrow { transform: rotate(180deg); }
</style>
