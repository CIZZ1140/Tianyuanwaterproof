---
import { ArrowRight, Check, FileText, MessageCircle } from 'lucide-astro';
import { productImage, productImageSet } from '../utils/productImages';

interface Props {
  title: string;
  overview: string;
  notice?: string;
  applications: { title: string; text: string }[];
  features: { title: string; text: string }[];
  specs: { label: string; value: string }[];
  technical: { label: string; value: string; unit?: string; standard?: string }[];
  steps: { title: string; text: string }[];
  images: { image: string; title: string; alt: string }[];
  procurement: { title: string; text: string }[];
  selectionNotes: { title: string; text: string }[];
  showComponentDetails: boolean;
  hasOverview: boolean;
  quoteHref: string;
  whatsappHref: string;
  tdsHref: string;
}
const { title, overview, notice, applications, features, specs, technical, steps, images, procurement, selectionNotes, showComponentDetails, hasOverview, quoteHref, whatsappHref, tdsHref } = Astro.props;
---

<section class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm" aria-labelledby="coating-applications">
  <div class="grid lg:grid-cols-2">
    <div class="min-w-0 bg-slate-100">
      {images[0] && <figure class="h-full flex flex-col">
        <img src={productImage(images[0].image, 800)?.src || images[0].image} srcset={productImageSet(images[0].image)} sizes="(min-width: 1680px) 800px, (min-width: 1024px) 46vw, calc(100vw - 64px)" alt={images[0].alt} width="960" height="720" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-contain lg:min-h-[360px]" />
        <figcaption class="bg-slate-100 px-6 py-3 text-xs text-slate-600">{images[0].title}</figcaption>
      </figure>}
    </div>
    <div class="p-6 sm:p-8 lg:p-10">
      <p class="mb-3 text-xs font-bold uppercase tracking-widest text-blue-700">Applications</p>
      <h2 id="coating-applications" class="text-2xl font-black tracking-tight text-slate-950">Where can you use it?</h2>
      <p class="mt-4 max-w-xl text-sm leading-7 text-slate-600">{overview}</p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {applications.map(item => <li class="flex items-start gap-2 text-sm font-bold text-slate-900"><Check class="mt-0.5 h-4 w-4 shrink-0 text-blue-700" />{item.title}</li>)}
      </ul>
      {notice && <p class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-950">{notice}</p>}
      <details class="mt-5 border-t border-slate-200 pt-4">
        <summary class="cursor-pointer text-sm font-bold text-blue-800">View requirements by application</summary>
        <dl class="mt-4 space-y-4">{applications.map(item => <div><dt class="text-sm font-bold text-slate-900">{item.title}</dt><dd class="mt-1 text-sm leading-6 text-slate-600">{item.text}</dd></div>)}</dl>
      </details>
      <a href={whatsappHref} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-emerald-800 hover:underline"><MessageCircle class="h-4 w-4" />Ask if this coating fits your project</a>
    </div>
  </div>
</section>

{features.length > 0 && <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
  <h2 class="text-2xl font-black tracking-tight text-slate-950">Product highlights</h2>
  <div class="mt-6 grid gap-6 md:grid-cols-3">
    {features.slice(0, 3).map((item, index) => <article class="border-t-2 border-blue-700 pt-4">
      <span class="text-xs font-bold text-blue-700">0{index + 1}</span>
      <h3 class="mt-2 text-base font-bold text-slate-950">{item.title}</h3>
      <p class="mt-2 text-sm leading-6 text-slate-600">{item.text}</p>
    </article>)}
  </div>
</section>}

<section id={showComponentDetails ? 'technical-specifications' : 'quick-specifications'} class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h2 class="text-2xl font-black tracking-tight text-slate-950">Product at a glance</h2>
    <a href={tdsHref} class="inline-flex items-center gap-2 text-sm font-bold text-blue-800"><FileText class="h-4 w-4" />Request TDS</a>
  </div>
  <dl class="mt-5 grid gap-x-8 md:grid-cols-2">{specs.map(row => <div class="grid grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] gap-4 border-b border-slate-100 py-4 text-sm"><dt class="font-bold text-slate-600">{row.label}</dt><dd class="leading-6 text-slate-900">{row.value}</dd></div>)}</dl>
  {selectionNotes.length > 0 && <details class="mt-5 rounded-xl border border-slate-200 px-4 py-4">
    <summary class="cursor-pointer text-sm font-bold text-blue-800">Grade selection &amp; ordering notes</summary>
    <dl class="mt-4 space-y-4">{selectionNotes.map(item => <div><dt class="text-sm font-bold text-slate-900">{item.title}</dt><dd class="mt-1 text-sm leading-6 text-slate-600">{item.text}</dd></div>)}</dl>
  </details>}
  {showComponentDetails && technical.length > 0 && <details class="mt-5 rounded-xl border border-slate-200 px-4 py-4">
    <summary class="cursor-pointer text-sm font-bold text-blue-800">Component &amp; application details</summary>
    <dl class="mt-4 space-y-4">{technical.map(row => <div class="grid gap-1 sm:grid-cols-[1fr_3fr] sm:gap-4"><dt class="text-sm font-bold text-slate-900">{row.label}</dt><dd class="text-sm leading-6 text-slate-600">{row.value}</dd></div>)}</dl>
  </details>}
</section>

{!showComponentDetails && <details class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
  <summary class="cursor-pointer text-base font-bold text-slate-900">View technical specifications</summary>
  <div class="mt-5"><slot name="technical" /></div>
</details>}

{steps.length > 0 && <section id="installation-guide" class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
  <h2 class="text-2xl font-black tracking-tight text-slate-950">Application in {steps.length} steps</h2>
  <p class="mt-2 text-sm leading-6 text-slate-600">Follow the product instructions for preparation, application conditions and curing times.</p>
  <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{steps.map((step, index) => <li class="rounded-xl bg-slate-50 p-4">
    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-blue-700 text-sm font-bold text-white">{index + 1}</span>
    <details class="mt-3"><summary class="cursor-pointer text-sm font-bold text-slate-950">{step.title}</summary><p class="mt-3 text-sm leading-6 text-slate-600">{step.text}</p></details>
  </li>)}</ol>
</section>}

{procurement.length > 0 && <details class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
  <summary class="cursor-pointer text-base font-bold text-slate-900">Packaging &amp; supply details</summary>
  <dl class="mt-5 grid gap-5 md:grid-cols-2">{procurement.map(item => <div><dt class="text-sm font-bold text-slate-900">{item.title}</dt><dd class="mt-2 text-sm leading-6 text-slate-600">{item.text}</dd></div>)}</dl>
</details>}

<section class="rounded-3xl bg-slate-900 p-6 text-white sm:p-8">
  <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-2xl"><h2 class="text-2xl font-black text-white">Need a price or help choosing?</h2><p class="mt-3 text-sm leading-7 text-slate-200">Tell us where you plan to use the coating and roughly how much you need. Ask about pricing, packaging or a suitable product for your project.</p><p class="mt-2 text-sm leading-6 text-slate-200">Not sure which specification you need? Start with your application.</p></div>
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row lg:flex-col">
      <a href={quoteHref} class="inline-flex items-center justify-center gap-3 rounded-xl bg-blue-600 px-6 py-4 text-sm font-bold text-white hover:bg-blue-500">Request a quote<ArrowRight class="h-4 w-4" /></a>
      <a href={whatsappHref} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-3 rounded-xl bg-emerald-700 px-6 py-4 text-sm font-bold text-white hover:bg-emerald-600"><MessageCircle class="h-4 w-4" />Chat on WhatsApp</a>
    </div>
  </div>
</section>

{hasOverview && <details class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
  <summary class="cursor-pointer text-base font-bold text-slate-900">More about {title}</summary>
  <div class="coating-overview mt-5 max-w-4xl text-sm leading-7 text-slate-600"><slot /></div>
</details>}
<style>
  .coating-overview :global(h2), .coating-overview :global(h3) { margin: 1.25rem 0 .5rem; font-weight: 700; color: #0f172a; }
  .coating-overview :global(p) { margin: .75rem 0; }
  .coating-overview :global(a) { color: #1d4ed8; text-decoration: underline; }
</style>
