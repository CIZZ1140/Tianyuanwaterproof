    <script is:inline>
      const mainImg = document.getElementById('main-product-image');
      const thumbs = document.querySelectorAll('.gallery-thumb');
      if (mainImg && thumbs.length > 0) {
        let switchToken = 0;
        let hoverTimer = null;
        thumbs.forEach((thumb, i) => {
          thumb.setAttribute('aria-pressed', i === 0 ? 'true' : 'false');
          const switchTo = () => {
            const token = ++switchToken;
            const newSrc = thumb.getAttribute('data-full');
            if (newSrc && mainImg.src !== newSrc) {
              thumbs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-pressed', 'false'); });
              thumb.classList.add('active');
              thumb.setAttribute('aria-pressed', 'true');
              mainImg.style.opacity = '0';
              setTimeout(() => {
                if (token !== switchToken) return;
                mainImg.removeAttribute('srcset');
                mainImg.src = newSrc;
                mainImg.onload = () => { if (token === switchToken) mainImg.style.opacity = '1'; };
              }, 200);
            }
          };
          thumb.addEventListener('click', switchTo);
          thumb.addEventListener('mouseenter', () => {
            clearTimeout(hoverTimer);
            hoverTimer = setTimeout(switchTo, 250);
          });
          thumb.addEventListener('mouseleave', () => clearTimeout(hoverTimer));
        });
      }
    </script>
