---
import { localizedPaths, translationLocales } from '../../i18n/routes.mjs';

// Register real localized routes for Astro and the sitemap. The build integration
// renders the final HTML from the corresponding English page, not a second template.
export function getStaticPaths() {
  return translationLocales.flatMap(locale => localizedPaths.map(path => ({
    params: { locale, path: path === '/' ? undefined : path.slice(1, -1) }
  })));
}
---
<!-- Full localized source page is emitted by the build integration. -->
