---
import Layout from '@/layouts/Layout.astro';
import { ArrowRight, ChevronRight } from 'lucide-astro';
import { applications as cards } from '@/data/site';
import CTA from '@/components/CTA.astro';
import { applications } from '@/data/applications';
export function getStaticPaths() { return applications.map((app) => ({ params: { slug: app.slug }, props: { app } })); }
const { app } = Astro.props;
const image = cards.find((card) => card.slug === app.slug)?.image;
const base = import.meta.env.BASE_URL;
const selection = {
  'roof-waterproofing': {
    intro: 'Compare waterproofing systems for new and existing concrete roofs, exposed flat roofs and complex roof details.',
    options: [
      ['Concrete flat roofs', 'Evaluate SBS or APP bitumen membranes for compatible concrete substrates. Confirm slope, drainage and whether the membrane will be exposed or protected.'],
      ['Exposed single-ply roofs', 'Evaluate TPO or PVC where the specified roof assembly supports the membrane and attachment method. Confirm wind uplift and compatibility with the existing layers.'],
      ['Renovation and roof details', 'Where open-flame work is restricted, review self-adhered systems. For drains, upstands and pipe penetrations, use compatible detailing accessories or liquid-applied materials.']
    ],
    checks: ['Parapet upstands and terminations', 'Drain flanges and overflow routes', 'Pipe penetrations and transitions'],
    resource: ['Compare SBS and APP membranes', '/blog/sbs-vs-app-modified-bitumen-membranes/'],
    related: ['Industrial & Metal Roofs', 'industrial-building']
  },
  'underground-waterproofing': {
    intro: 'Choose below-grade waterproofing by construction sequence, access and groundwater conditions.',
    options: [
      ['Before the slab is poured', 'Evaluate pre-applied HDPE for blindside or under-slab work. Check the membrane-to-concrete bond, overlaps and the transition from the slab to the wall.'],
      ['After the wall is cast', 'Where the outside face is accessible, evaluate self-adhered or modified bitumen membranes. Confirm wall preparation, termination, backfill protection and drainage.'],
      ['Groundwater and construction joints', 'Confirm groundwater level and design pressure. Coordinate waterstops and penetrations with the specified waterproofing system.']
    ],
    checks: ['Slab-to-wall continuity', 'Service penetrations and construction joints', 'Protection before backfill'],
    resource: ['Read the basement and foundation guide', '/blog/sbs-membrane-basement-foundation-waterproofing/']
  },
  'industrial-building': {
    intro: 'Plan leak repairs and roof renovation for warehouses, factories and steel buildings.',
    options: [
      ['Localized leaks', 'Inspect side laps, fasteners, skylight curbs and penetrations. Evaluate compatible butyl flashing or detail coatings after checking corrosion, movement and substrate condition.'],
      ['Coating-based refurbishment', 'For a sound metal roof, confirm adhesion, primer compatibility and reinforcement at details before considering a coating system.'],
      ['Full roof renovation', 'Evaluate a TPO or PVC assembly where the existing deck and attachment design support it. Check wind loads, insulation, condensation risk and drainage.']
    ],
    checks: ['Metal sheet laps and fastener heads', 'Skylight curbs and service penetrations', 'Corrosion and roof movement'],
    related: ['Roof Waterproofing', 'roof-waterproofing']
  },
  'tunnel-waterproofing': {
    intro: 'Review sheet membrane systems for road, railway and subway tunnels based on drainage design and lining sequence.',
    options: [
      ['Drained tunnel designs', 'For an umbrella layout, coordinate the membrane coverage with side drains and outlets specified by the project engineer.'],
      ['Undrained tunnel designs', 'For a full-round layout, confirm hydrostatic design pressure and how the membrane joins across the invert, walls and crown.'],
      ['Membrane and protection layers', 'Evaluate project-approved PVC-P or FPO grades, compatible protective geotextile and the specified weld testing and inspection method.']
    ],
    checks: ['Protection against rough shotcrete', 'Welded seams and inspection access', 'Invert transitions and compartment boundaries'],
    resource: ['Read the tunnel membrane selection guide', '/blog/tunnel-waterproofing-membrane-selection/']
  },
  'bridge-infrastructure': {
    intro: 'Select a bridge deck waterproofing system around the concrete substrate, wearing course and project specification.',
    options: [
      ['Decks receiving asphalt overlays', 'Evaluate approved fully bonded bitumen sheets. Confirm compatibility with paving temperature, traffic loading and the required bond to the deck and wearing course.'],
      ['Liquid-applied systems', 'Evaluate project-approved PU or polyurea where deck geometry favors a continuous coating. Verify cure conditions and compatibility with the specified overlay.'],
      ['Drainage and terminations', 'Coordinate deck drains, edge terminations and movement joints with the drainage and paving designs.']
    ],
    checks: ['Concrete preparation and adhesion', 'Deck drains, kerbs and terminations', 'Overlay compatibility and paving temperature']
  },
  'bathroom-waterproofing': {
    intro: 'Plan waterproofing for tiled bathrooms, showers and other wet areas, with separate checks for balconies and exposed locations.',
    options: [
      ['Tiled floors and shower walls', 'Evaluate polymer cement (JS) coatings for compatible mineral substrates. Confirm required coverage and suitability beneath the specified tile adhesive.'],
      ['Balconies and exposed areas', 'Evaluate a compatible PU system where the exposure, finish and drainage design allow it. Confirm UV exposure, protection and standing-water requirements.'],
      ['Wet-area details', 'Coordinate compatible detailing tapes or reinforcement with the coating at wall-to-floor corners, drains and pipe sleeves.']
    ],
    checks: ['Wall-to-floor corners', 'Drain flanges and floor falls', 'Pipe sleeves and transitions to dry areas'],
    resource: ['Compare waterproof coating systems', '/categories/waterproof-coatings/']
  },
  'joint-detail-sealing': {
    intro: 'Compare flashing and sealing materials for roof laps, perimeter details and service penetrations.',
    options: [
      ['Metal laps and flashings', 'Evaluate compatible butyl flashing tape for the metal or adjacent substrate. Confirm surface preparation, compression and exposure limits.'],
      ['Compatible bituminous repairs', 'Evaluate self-adhesive bitumen flashing where the substrate and existing waterproofing allow it. Check temperature, primer and exposure requirements.'],
      ['Structural movement joints', 'Use a designed joint assembly matched to the movement range and project specification. Check how it connects to the surrounding waterproofing.']
    ],
    checks: ['Lap orientation and water runoff', 'Substrate and sealant compatibility', 'Joint movement and exposure']
  }
}[app.slug];

const appUrl = `https://www.tyuanwaterproof.com/applications/${app.slug}/`;
const applicationSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${appUrl}#webpage`,
      url: appUrl,
      name: `${app.title} | Waterproofing Solutions`,
      description: app.description,
      isPartOf: { '@id': 'https://www.tyuanwaterproof.com/#website' }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tyuanwaterproof.com/' },
        { '@type': 'ListItem', position: 2, name: 'Applications', item: 'https://www.tyuanwaterproof.com/applications/' },
        { '@type': 'ListItem', position: 3, name: app.title, item: appUrl }
      ]
    },
    {
      '@type': 'ItemList',
      name: `Recommended products for ${app.title}`,
      numberOfItems: app.recommended.length,
      itemListElement: app.recommended.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item.title,
        url: `https://www.tyuanwaterproof.com${item.href}`
      }))
    }
  ]
};
---
<Layout title={`${app.title} | Waterproofing Solutions`} description={app.description} ogImage={image} ogType="website">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(applicationSchema)} />
  <section class="bg-[#0E2A47] text-white">
    <div class="container-wrap grid items-center gap-7 py-9 md:grid-cols-2 md:gap-12 md:py-14">
      <div>
        <nav aria-label="Breadcrumb" class="mb-5 flex items-center gap-2 text-sm text-slate-300">
          <a href={`${base}applications/`} class="hover:text-white hover:underline">Solutions</a>
          <ChevronRight class="h-4 w-4" aria-hidden="true" />
          <span aria-current="page">{app.title}</span>
        </nav>
        <h1 class="text-4xl font-black tracking-tight text-white md:text-5xl">{app.title}</h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-slate-200 md:text-lg">{selection.intro}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#system-selection" class="rounded-lg bg-[#F58A1F] px-5 py-3 font-bold text-[#0E2A47] hover:bg-orange-300">Compare systems</a>
          <a href="#inquiry" class="rounded-lg border border-white/40 px-5 py-3 font-bold text-white hover:bg-white/10">Discuss your project</a>
        </div>
      </div>
      {image && <img src={image} alt="" width="800" height="500" fetchpriority="high" class="aspect-[16/8] w-full rounded-xl object-cover md:aspect-[8/5]" />}
    </div>
  </section>
  <section id="system-selection" class="scroll-mt-24 bg-slate-50 py-12 md:py-16" aria-labelledby="system-title">
    <div class="container-wrap">
      <h2 id="system-title" class="text-3xl font-black text-[#0E2A47]">Choose by project condition</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {selection.options.map(([heading, text]) => (
          <div class="rounded-xl border border-slate-200 border-t-4 border-t-[#F58A1F] bg-white p-5 md:p-6">
            <h3 class="text-lg font-extrabold text-[#0E2A47]">{heading}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-700">{text}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 rounded-xl bg-[#EAF1F7] p-6">
        <h3 class="text-xl font-extrabold text-[#0E2A47]">Details to check</h3>
        <ul class="mt-4 grid gap-3 md:grid-cols-3">
          {selection.checks.map((check) => (
            <li class="flex gap-3 text-sm font-medium text-[#0E2A47]"><span aria-hidden="true" class="font-bold text-[#A54409]">✓</span>{check}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>
  <section class="py-12 md:py-16" aria-labelledby="products-title">
    <div class="container-wrap">
      <h2 id="products-title" class="text-3xl font-black text-[#0E2A47]">Products and technical resources</h2>
      <ul class="mt-6 grid gap-3 md:grid-cols-2">
        {app.recommended.map((item) => (
          <li>
            <a href={`${base}${item.href.slice(1)}`} class="flex h-full items-center justify-between gap-3 rounded-lg border border-slate-200 px-4 py-4 font-semibold text-[#0E2A47] hover:border-[#F58A1F]">
              {item.title}<ArrowRight class="h-4 w-4 shrink-0" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm font-bold text-[#0E2A47]">
        <a href={`${base}technical/`} class="underline underline-offset-4">Browse technical data</a>
        {'resource' in selection && selection.resource && <a href={`${base}${selection.resource[1].slice(1)}`} class="underline underline-offset-4">{selection.resource[0]}</a>}
        {'related' in selection && selection.related && <a href={`${base}applications/${selection.related[1]}/`} class="underline underline-offset-4">{selection.related[0]}</a>}
      </div>
    </div>
  </section>
  <CTA application={app.title} />
</Layout>
